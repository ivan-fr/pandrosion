Bcharge_sample 0 stored I=v(edge_sample)*(4.9999999999999996e-05)*(1+(0.10000000000000001)*(v(stored)/.7)^2)
Vedge_update edge_update 0 PULSE(0 1 400.01999999999998u 1n 1n 9n 420.0u)
Bcharge_update 0 state I=v(edge_update)*(4.9999999999999996e-05)*(1+(0.10000000000000001)*(v(state)/.7)^2)
Ithermal0 0 state PULSE(0 2.6615547817301897e-06 400.01999999999998u 1n 1n 9n 10080.0u)
Ithermal1 0 state PULSE(0 6.2275910282874601e-07 820.01999999999998u 1n 1n 9n 10080.0u)
Ithermal2 0 state PULSE(0 2.7342149084936692e-07 1240.02u 1n 1n 9n 10080.0u)
Ithermal3 0 state PULSE(0 -7.4837434803053535e-07 1660.02u 1n 1n 9n 10080.0u)
Ithermal4 0 state PULSE(0 -1.2522162336927811e-07 2080.02u 1n 1n 9n 10080.0u)
Ithermal5 0 state PULSE(0 -2.0179302660025039e-06 2500.02u 1n 1n 9n 10080.0u)
Ithermal6 0 state PULSE(0 3.8448743680544176e-07 2920.02u 1n 1n 9n 10080.0u)
Ithermal7 0 state PULSE(0 2.104378973268559e-06 3340.02u 1n 1n 9n 10080.0u)
Ithermal8 0 state PULSE(0 -9.8811406439386788e-08 3760.02u 1n 1n 9n 10080.0u)
Ithermal9 0 state PULSE(0 1.593130468822094e-06 4180.0200000000004u 1n 1n 9n 10080.0u)
Ithermal10 0 state PULSE(0 -1.6294389906454599e-07 4600.0200000000004u 1n 1n 9n 10080.0u)
Ithermal11 0 state PULSE(0 -1.5400137684855574e-06 5020.0200000000004u 1n 1n 9n 10080.0u)
Bdrive_candidate candidate_drive candidate I=0.002*tanh((v(candidate_drive)-v(candidate))/(0.02))
Bmonitor_c monitor_c 0 V=0.002*tanh((v(candidate_drive)-v(candidate))/(0.02))
Bmonitor_s monitor_s 0 V=0.002*tanh((v(stored_drive)-v(stored_read))/(0.02))
.control
set numdgt=16
set wr_singlescale
set wr_vecnames
tran 1u 0.0050399999999999993 uic
wrdata wave.txt v(state) v(q) v(residual) v(candidate) v(denominator) v(target) v(stagepeak) v(stored) v(stored_read) v(monitor_c) v(monitor_s)
quit
.endc
.end
